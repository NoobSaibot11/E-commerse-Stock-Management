# Copy to .env. Matches the postgres service in docker-compose.yml.
DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5433/ecommerce"
PORT=50051

# Signs login tokens. Any random string of 32+ characters; use a different,
# secret value in every real deployment.
JWT_SECRET="dev-only-secret-change-me-0123456789abcdef"
JWT_EXPIRES_IN="1h"
